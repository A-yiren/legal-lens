# ===== 基础配置 =====
APP_NAME=律瞳 LegalLens
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8765

# ===== LLM 配置 =====
# MiniMax 国内版
LLM_PROVIDER=MiniMax
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=abab6.5s-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4000

# ===== Embedding =====
# CPU 跑 BGE-M3 较慢（首次加载约 1-2 分钟），但能跑
EMBEDDING_DEVICE=cpu
EMBEDDING_USE_FP16=false
EMBEDDING_BATCH_SIZE=4

# ===== Qdrant =====
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=legal_knowledge

# ===== Obsidian =====
# OBSIDIAN_VAULT_PATH=C:/Users/YourName/Documents/MyVault
OBSIDIAN_WATCH_ENABLED=true
