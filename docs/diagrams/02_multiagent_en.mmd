flowchart LR
    Input["📥 Case Input"] --> Retrieve

    subgraph RAG ["🔍 Step 1: RAG Retrieval"]
        Retrieve["Embedding + Qdrant<br/>Hybrid search top-20"]
        Rerank["RRF Fusion + Rerank<br/>Feed to LLM"]
    end

    Retrieve --> Rerank

    Rerank --> Parallel

    subgraph Parallel ["⚡ Step 2: Parallel Execution"]
        direction TB
        A1["🤖 A1 Focus ID Agent<br/>Identify legal relations / disputes"]
        A4["🤖 A4 Risk Assessment Agent<br/>Scan potential legal risks"]
    end

    Parallel --> A2

    A2["🤖 A2 Legal Analysis Agent<br/>Based on A1 focus + retrieved laws<br/>Output analysis with [n] citations"] --> A3

