    A3["🤖 A3 Citation Validation Agent ⭐<br/>Verify each [n] citation<br/>is genuinely in the retrieved docs<br/>Tag 'hallucination' / 'verified'"]

    style A3 fill:#fbbf24,stroke:#d97706,stroke-width:4px,color:#000

    A3 --> Integrate

    subgraph Integrate ["📦 Step 5: Integration & Output"]
        direction TB
        I1["Filter A3-tagged hallucination citations"]
        I2["Deduplicate by law+article"]
        I3["Enrich metadata<br/>(official source / publisher / status)"]
        I4["Renumber [1] [2] [3]"]
        I5["Recompute confidence score"]
    end

    Integrate --> Output

    Output["📤 Final Output<br/>Each point linked to official source<br/>One-click jump to official law database"]

    style Output fill:#0c4a3e,stroke:#083029,stroke-width:3px,color:#fff

