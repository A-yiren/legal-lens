flowchart LR
    E1["<b>1 任务输入</b><br/>用户粘贴案情<br/>上传合同"]:::step
    E2["<b>2 任务拆解</b><br/>A1 提取案由<br/>金额/当事人/争议焦点"]:::step
    E3["<b>3 上下文传递</b><br/>A1→A2→A3→A4<br/>关键事实压缩"]:::step
    E4["<b>4 工具调用</b><br/>A2/A3 调 RAG<br/>A4 调 LLM"]:::step
    E5["<b>5 结果验证</b><br/>A3 逐条核验<br/>[n] 引用真实性"]:::step
    E6["<b>6 证据沉淀</b><br/>结果入 SQLite<br/>入参到案件库"]:::step
    E7["<b>7 审批与回滚</b><br/>案件库 PUT/DELETE<br/>端点生效"]:::step
    E8["<b>8 经验沉淀</b><br/>模板复用<br/>历史分析复盘"]:::step

    E1 ==> E2 ==> E3 ==> E4 ==> E5 ==> E6 ==> E7 ==> E8

    classDef step fill:#dcfce7,stroke:#0c4a3e,stroke-width:2px,color:#0c4a3e
